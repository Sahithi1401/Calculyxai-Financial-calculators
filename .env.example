# ─────────────────────────────────────────────────────────────
# Calculyx AI — Environment Variables (Vercel compatible)
# Copy to `.env` locally, and paste into Vercel → Project Settings → Environment Variables.
# All VITE_* vars are exposed to the browser. Everything else is server-only.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Client) ────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your_project_ref

# ── Supabase (Server) ────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 🔴 SECRET — never expose. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── AI (Groq) ────────────────────────────────────────────────
# Used for all AI insights, chat, and analysis. Get key at https://console.groq.com
GROQ_API_KEY=gsk_xxx

# ── Market Data ──────────────────────────────────────────────
# US stock quotes — https://finnhub.io
FINNHUB_API_KEY=xxx
# NSE / BSE Indian stock data — https://indianapi.in
INDIAN_STOCK_API_KEY=xxx

# ── Email (Resend) ───────────────────────────────────────────
# Transactional email — https://resend.com
RESEND_API_KEY=re_xxx
# Verified sender. Use `onboarding@resend.dev` for testing.
RESEND_FROM="Calculyx AI <no-reply@calculyxai.online>"

# ── Public Logos ─────────────────────────────────────────────
# Public key from https://logo.dev
VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY=pk_xxx
